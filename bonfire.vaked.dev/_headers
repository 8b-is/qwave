# bonfire.vaked.dev — edge headers (Cloudflare Pages)
# Spec §9: CSP, X-Robots-Tag: noai, no-store, nosniff, SAMEORIGIN.
#
# Pages serves .html at extensionless URLs (a 308 takes /fire.html → /fire),
# so the .html rules below apply to the redirect hop and the extensionless
# rules to the document itself — both are declared on purpose.

/*
  # script-src stays 'self': no third-party code, no eval. script-src-elem
  # admits 'unsafe-inline' for exactly one reason — the vaked.dev zone runs
  # Cloudflare's JavaScript-Detection challenge, which injects an inline
  # bootstrap (<script>window.__CF$cv$params…) into every HTML response.
  # Under a pure 'self' policy that inline script is blocked, the challenge
  # never completes, and Cloudflare answers the follow-up requests with 403.
  # Inline event handlers stay banned via script-src-attr 'none'.
  Content-Security-Policy: default-src 'self'; script-src 'self'; script-src-elem 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://music.vaked.dev; frame-src https://music.vaked.dev; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noai, noimageai
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# The pages themselves are never cached: a fire's state is the point.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store

# The fire room and the ash page — both as .html (the redirect hop) and as
# the extensionless document Pages actually serves.
/fire.html
  ! X-Robots-Tag
  Cache-Control: no-store
  X-Robots-Tag: noai, noimageai, noindex
/fire
  ! X-Robots-Tag
  Cache-Control: no-store
  X-Robots-Tag: noai, noimageai, noindex
/ash.html
  ! X-Robots-Tag
  Cache-Control: no-store
  X-Robots-Tag: noai, noimageai, noindex
/ash
  ! X-Robots-Tag
  Cache-Control: no-store
  X-Robots-Tag: noai, noimageai, noindex
/404.html
  ! X-Robots-Tag
  Cache-Control: no-store
  X-Robots-Tag: noai, noimageai, noindex

# The lattice is never cached, and never indexed.
/api/*
  ! X-Robots-Tag
  Cache-Control: no-store
  X-Robots-Tag: noai, noimageai, noindex

# Static assets and the contract code are content-hashed at deploy time
# (scripts/deploy.js rewrites every reference), so a year of immutable
# caching is honest: a new deploy is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/shared/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# Agent-facing documents: readable by tools, cached like policy files.
/llms.txt
  Cache-Control: public, max-age=3600
/AGENTS.md
  Cache-Control: public, max-age=3600
/.well-known/*
  Cache-Control: public, max-age=3600
